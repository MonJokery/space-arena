{
  "name": "space-arena-lab-08",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run typecheck && npm run build --workspace client && npm run build:server",
    "start": "node server/dist/index.mjs",
    "test": "vitest run --coverage",
    "lint": "npm run lint --workspace client",
    "format": "npm run format --workspace client",
    "measure:protocol": "node --import tsx scripts/measure-protocol.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "load": "node --import tsx scripts/load.ts",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server/dist/index.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "vitest": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "fast-check": "^4.2.0",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0"
  }
}
